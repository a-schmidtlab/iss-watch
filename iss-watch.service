[Unit]
Description=ISS Watch Kiosk (ISS-Stream, Wetter-Dashboard)
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
# Wayland: WAYLAND_DISPLAY importiert der Autostart-Eintrag (iss-watch.desktop)
ExecStart=/usr/bin/python3 -u %h/iss/iss_watch.py
Restart=always
RestartSec=15
# Logger und Exporter des wetterraspi5 haben Vorrang vor Stream und Browser
Nice=10

[Install]
WantedBy=default.target
